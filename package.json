{
  "name": "loginpilot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "lp:dev": "vite --config sites/lp/vite.config.ts",
    "lp:build": "vite build --config sites/lp/vite.config.ts",
    "lp:preview": "vite preview --config sites/lp/vite.config.ts",
    "lp:deploy": "npm run lp:build && wrangler deploy --config sites/lp/wrangler.jsonc",
    "icons:generate": "node scripts/generate-icons.mjs",
    "build": "wxt build",
    "dev": "wxt",
    "typecheck": "wxt prepare && tsc --noEmit",
    "test": "vitest run",
    "zip": "wxt zip"
  },
  "dependencies": {
    "@tailwindcss/vite": "4.3.2",
    "tailwindcss": "4.3.2",
    "wxt": "0.20.27"
  },
  "devDependencies": {
    "@resvg/resvg-js": "2.6.2",
    "typescript": "7.0.2",
    "vite": "8.1.4",
    "vitest": "4.1.10",
    "wrangler": "4.142.0"
  }
}
